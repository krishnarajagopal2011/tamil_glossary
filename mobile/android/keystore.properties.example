# Copy to android/keystore.properties and fill in. Never commit the real file
# or the .jks it points at — losing the upload key means losing the ability to
# update the listing, and Google cannot reissue it.
#
# Create the key first:
#
#   keytool -genkeypair -v \
#     -keystore ~/glossary-upload-key.jks \
#     -alias glossary-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=/absolute/path/to/glossary-upload-key.jks
storePassword=
keyAlias=glossary-upload
keyPassword=
